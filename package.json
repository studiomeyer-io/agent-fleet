{
  "name": "@studiomeyer-io/agent-fleet",
  "version": "0.3.0",
  "description": "Multi-agent orchestration framework for Claude Code CLI. Run agents in parallel (Conductor) or stateful workflows with crash-resume + Human-in-the-Loop (Conductor-LangGraph). Subscription-flat by default.",
  "type": "module",
  "author": "StudioMeyer <hello@studiomeyer.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/studiomeyer-io/agent-fleet.git"
  },
  "homepage": "https://github.com/studiomeyer-io/agent-fleet#readme",
  "bugs": {
    "url": "https://github.com/studiomeyer-io/agent-fleet/issues"
  },
  "keywords": [
    "ai-agents",
    "claude",
    "claude-code",
    "multi-agent",
    "mcp",
    "orchestration",
    "research",
    "code-analysis",
    "autonomous-agents"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "agent-fleet": "./dist/agents/cli.js"
  },
  "main": "./dist/agents/index.js",
  "types": "./dist/agents/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/agents/index.js",
      "types": "./dist/agents/index.d.ts"
    },
    "./mcp-config": {
      "import": "./dist/agents/lib/mcp-config.js",
      "types": "./dist/agents/lib/mcp-config.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema.sql",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "research": "npx tsx agents/research-agent.ts",
    "critic": "npx tsx agents/critic-agent.ts",
    "analyst": "npx tsx agents/analyst-agent.ts",
    "cto": "npx tsx agents/cto-agent.ts",
    "discovery": "npx tsx agents/discovery-agent.ts",
    "repair": "npx tsx agents/repair-agent.ts",
    "conductor": "npx tsx agents/conductor.ts",
    "conductor-langgraph": "npx tsx agents/conductor-langgraph.ts",
    "langgraph:setup": "npx tsx scripts/setup-langgraph-checkpointer.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "prepublishOnly": "npm run clean && npm run build && npm run check && npm run typecheck && npm test"
  },
  "dependencies": {},
  "peerDependencies": {
    "@langchain/langgraph": "^1.3.6",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.2",
    "pg": "^8.21.0"
  },
  "peerDependenciesMeta": {
    "@langchain/langgraph": {
      "optional": true
    },
    "@langchain/langgraph-checkpoint-postgres": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@langchain/langgraph": "^1.3.6",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.2",
    "@types/node": "^25.9.2",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^4.1.9",
    "pg": "^8.21.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
